---
import Layout from '../layouts/Layout.astro';

// Home, How I work, About me and Expertise (with its four branch slides),
// plus the photo wall, while the site is rebuilt.
const BOOK_URL = 'https://tidycal.com/ldante';

const ways = [
  { title: 'Design leadership', body: 'Direction, critique, team mentorship, hiring, and organizational structure.' },
  { title: 'Product strategy', body: 'Helping teams turn ambiguous problems into something they can actually build.' },
  { title: 'Design systems', body: 'Creating the foundations, standards, and governance that make quality repeatable.' },
  { title: 'Hands-on product design', body: 'Diving into the work when something needs design attention.' },
  { title: 'Interim leadership', body: "Keeping the team moving when you're between design leaders or building your team." },
];

// Photos taped to the whiteboard below the slides. x/y/w/r place each print
// on the board (desktop canvas); on phones they stack with their captions.
const photos = [
  { src: '/photos/window-518.webp', iw: 1200, ih: 1500, title: 'Nashville, TN', caption: 'Capturing wonderful textures in broken glass, steel and brick.', alt: 'A rusted steel factory window with cracked wired-glass panes and the number 518, set in red brick.', x: 40, y: 250, w: 400, r: -4 },
  { src: '/photos/junkyard-stack.webp', iw: 1600, ih: 1066, title: 'Nashville, TN', caption: 'All journeys end.', alt: 'Crushed cars stacked high in a scrapyard under a grey sky, a Dodge truck grille at the bottom.', x: 520, y: 210, w: 580, r: 3 },
  { src: '/photos/pinstripe-dash.webp', iw: 1600, ih: 1066, title: 'San Diego, CA', caption: 'A Sunday at Balboa Park.', alt: 'The candy-red dashboard of a classic hot rod with pinstriping, round gauges and a wooden steering wheel.', x: 1180, y: 300, w: 540, r: -2.5 },
  { src: '/photos/flower-wall.webp', iw: 1200, ih: 1600, title: 'Toronto, Canada', caption: 'A bed of roses.', alt: 'A dense wall of pink, white, purple and yellow roses and hydrangeas.', x: 1800, y: 190, w: 380, r: 5 },
  { src: '/photos/reflection.webp', iw: 1600, ih: 1066, title: 'Palm Springs, CA', caption: 'Cooling down in the car from 100+ degree heat.', alt: 'A smiling woman with long braids seen through a car window, the street reflected across the glass.', x: 60, y: 860, w: 560, r: -3.5 },
  { src: '/photos/gel-light.webp', iw: 1066, ih: 1600, title: 'Lighting Test Shot', caption: 'This is my son as a test subject while testing a new light setup.', alt: 'My son, with curly hair, looking upward, lit blue from one side and red from the other.', x: 700, y: 800, w: 360, r: 3 },
  { src: '/photos/sean-obryan-smith.webp', iw: 1600, ih: 1066, title: "Sean O'Bryan Smith", caption: 'Jazz bassist. Nashville, TN', alt: "Sean O'Bryan Smith seated among rows of wooden theater seats, holding a five-string bass.", x: 1160, y: 830, w: 560, r: -2 },
  { src: '/photos/john-gray.webp', iw: 1600, ih: 1066, title: 'John Gray', caption: 'Pastor and speaker, John Gray. Nashville, TN', alt: 'John Gray in a leather jacket against a brick wall, wiping his face with a white towel.', x: 380, y: 1330, w: 540, r: 2 },
  { src: '/photos/kortney-wilson.webp', iw: 1000, ih: 1500, title: 'Kortney Wilson', caption: 'Musician & TV Personality. Nashville, TN', alt: 'Kortney Wilson in a pink feather headpiece and tall brown boots, leaning against a peeling teal wall.', x: 2300, y: 240, w: 360, r: -3 },
  { src: '/photos/beat-kangz.webp', iw: 1600, ih: 1280, title: 'The Beat Kangz', caption: 'Producers & Entrepreneurs', alt: 'The three members of The Beat Kangz in sunglasses on a gravel lot, the Nashville skyline behind them.', x: 1820, y: 820, w: 520, r: 2.5 },
  { src: '/photos/union-jordan-2.webp', iw: 1280, ih: 1600, title: 'Union Jordan 2', caption: 'Light experiments with projectors', alt: 'Union Jordan 2 sneakers and trousers covered in a projected geometric light pattern.', x: 1060, y: 1440, w: 380, r: -4 },
];

const clients = ['Adobe', 'Teamshares', 'Upwork', 'T-Mobile', 'Microsoft', 'Greenpeace International'];

// Work's branch slides. Copy is still to come, so each is a title for now.
// Work sits nudged right so it's centred over all four.
const workAreas = [
  { id: 'expertise-strategy', title: 'Strategy', pos: '--c:3;--r:2;--dx:120px;--dy:40px;--tilt:-1deg', tape: '--tape-r:2deg;width:230px',
    body: [
      "Most briefs describe a symptom, so my first job is finding the problem underneath it. At Meroxa, growth had stalled and the instinct was better onboarding. My research showed we'd built the right product for the wrong person, and it led a pivot from a builder tool to a data observability platform that expanded our addressable market 10x.",
      "At Marketo, the new Sky experience had been ready for years, but fewer than 600 users had opted in. Nobody had designed the transition, so we did: a phased hybrid that brought Sky features into the Classic interface first and moved navigation last, so users got the improvements without the disruption. Opt-ins grew from under 600 to more than 5,000.",
      "It starts close to the work. Site visits at MedHost's partner hospitals surfaced a scheduling gap that led them to adopt an in-house tool over third-party calendars. At Sixup, bringing in qualitative research shifted the roadmap's priorities.",
    ],
  },
  { id: 'expertise-systems-thinking', title: 'Systems Thinking', pos: '--c:4;--r:2;--dx:30px;--dy:130px;--tilt:0.8deg', tape: '--tape-r:-2.5deg;width:250px',
    body: [
      "I think in systems first, then UI. A screen is the last step of a chain of decisions about data, ownership and flow, and that chain is usually where the real problem lives. At Teamshares, the ask was \"build an ATS.\" The real problem was a hiring model running on spreadsheets while the company acquired businesses faster than it could place leaders to run them. Designing the system instead of the tool gave the team one source of truth across 80+ acquired companies and placed 20+ leaders.",
      "The same lens shaped the payroll dashboard there. Integration was the expensive part, so we built it once for the whole platform to inherit, and cut the analysis time of the company's financial leads in half. At Marketo, I went after the org model rather than the components, and ran internal workshops on systems thinking. At the healthtech startup I'm with now, every prototype feeds what it learns back into the design system, so each new one starts from more of the product than the last.",
    ],
  },
  { id: 'expertise-design-systems', title: 'Design Systems', pos: '--c:5;--r:2;--dx:-60px;--dy:20px;--tilt:-1.4deg', tape: '--tape-r:1.5deg;width:220px',
    body: [
      "I founded Marketo's Sky Design System, built the team behind it, and led its evangelism across Marketo's product squads. At Meroxa, I used Tailwind CSS as a solid baseline for the Yoshi Design System. I contributed to the design system at Teamshares, and helped retrofit T-Mobile's Arrow Design System for B2B use in T-Mobile for Business.",
      "Lately I've been making Figma design system libraries AI-ready, and using AI to learn a system's guardrails and build out its assets with far greater efficiency.",
    ],
    // More images go here; on the canvas, scrolling flips through them
    // before moving on to the next slide.
    shots: [
      { src: '/work/design-systems-sceptre.webp', w: 1600, h: 1138, alt: "A design system documentation site: a sidebar of foundations and components beside a page of brand, background and border colour swatches." },
    ],
  },
  { id: 'expertise-web', title: 'Web & Mobile', pos: '--c:6;--r:2;--dx:-140px;--dy:110px;--tilt:1.2deg', tape: '--tape-r:-1.5deg;width:240px',
    body: [
      "I started my career writing front-end code, and I still design with how it will be built in mind. At Upwork, I designed collaboration tools for freelancers and clients and shipped the Upwork Teams app on desktop and mobile. At T-Mobile for Business, I led end-to-end design for promotion, trade-in and quote-to-order flows across its B2B surfaces.",
      "At a healthtech startup, I extended the design system to mobile with the same token and component logic as desktop rather than a separate mobile system, so one foundation serves both and nothing drifts between them.",
    ],
  },
];

const eyebrow = 'led-eyebrow mb-4';
// Section titles: Permanent Marker, off-white. Only the hero h1 sits on tape.
const h2 = 'tape-title';
const section = 'border-t border-white/10 py-20 md:py-28';
// Buttons: off-white for primary actions, dark grey for secondary ones.
const pill = 'btn';
const pillSecondary = 'btn btn--dark';
---

<Layout>
  <div id="canvas-viewport" tabindex="0" aria-label="Canvas. Drag to pan, scroll to move between panels, plus and minus to zoom, 0 for the top panel.">
  <main id="main">
    <div id="canvas-grid" style="--cols:6;--rows:2">
      <!-- HERO -->
      <section id="hero" style="--c:1;--r:1;--dx:-30px;--dy:70px;--tilt:-1.3deg" data-tile data-label="Home" class="tile">
      <span class="tape tile-tape" style="--tape-r:-3deg;width:250px" aria-hidden="true"></span>
      <div class="tile-clip">
        <!-- Background loop: "Aerial View of Busy Los Angeles Intersection"
             by Logan Voss, via Pexels (free licence). Muted and decorative. -->
        <video class="hero-video" src="/videos/la-crosswalk.mp4" autoplay muted loop playsinline preload="auto" aria-hidden="true" tabindex="-1"></video>
        <div class="hero-scrim" aria-hidden="true"></div>
      </div>
      <div class="tile-inner max-w-6xl mx-auto px-6 md:px-8 pt-28 pb-16 md:pb-20 slide:max-w-[760px]">
        <div>
        <div>
        <p class="text-lg text-pink mb-8 slide:mb-5">
          <span class="font-semibold">L Dante Guarin —</span> Fractional Design Lead · Product Design · Design Systems
        </p>
        <h1 class="tape-title tape-title--hero max-w-4xl mb-10 slide:mb-7"><span class="tape">Let's Work!</span></h1>
        <p class="text-lg md:text-xl leading-relaxed max-w-3xl mb-10 slide:mb-6 slide:max-w-[680px]">
          I help growing product teams decide better, build better, and put the design systems in place to scale. Leadership where you need it, hands-on where it counts, and a direct line to Product, Engineering, and your leadership team.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={BOOK_URL} target="_blank" rel="noopener noreferrer" class={`${pill} text-base px-6 py-3.5`}>
            Book an intro call
          </a>
          <a href="mailto:hello@ldante.com" class={`${pillSecondary} text-base px-6 py-3.5`}>
            Get in touch
          </a>
        </div>
        </div>
        <div id="experience" class="mt-16 pt-16 border-t border-white/10 slide:mt-6 slide:pt-5">
          <p class={`${eyebrow} led-eyebrow--lg slide:mb-0`}>20+ years of leading design across web, branding and product</p>
        </div>
        </div>
      </div>
      </section>

      <!-- HOW I WORK -->
      <section id="how-i-work" style="--c:2;--r:1;--dx:110px;--dy:-140px;--tilt:0.9deg" data-tile data-label="How I work" class={`tile ${section}`} data-reveal>
        <span class="tape tile-tape" style="--tape-r:2.5deg;width:220px" aria-hidden="true"></span>
        <div class="tile-inner max-w-6xl mx-auto px-6 md:px-8">
          <p class={eyebrow}>How I work</p>
          <h2 class={`${h2} max-w-3xl mb-6`}>Short-term leadership. Full-time commitment to the work.</h2>
          <p class="text-lg md:text-xl leading-relaxed max-w-3xl mb-12 slide:mb-10">
            I embed with your team rather than operating from the sidelines. I work directly with founders, Product, Engineering, and Design to understand what's getting in the way, establish priorities, and move the work forward.
          </p>

          <ul class="grid sm:grid-cols-2 slide:grid-cols-3 gap-4 slide:gap-5">
            {ways.map((w) => (
              <li class="rounded-2xl border border-white/10 bg-card p-6 slide:p-7">
                <h3 class="font-display font-normal text-[22px] slide:text-[26px] leading-tight tracking-[-0.01em] text-white mb-3">{w.title}</h3>
                <p class="text-base slide:text-lg leading-relaxed">{w.body}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- WHY ME -->
      <section id="why-me" style="--c:3;--r:1;--dx:-40px;--dy:120px;--tilt:-0.8deg" data-tile data-label="About me" class={`tile ${section}`} data-reveal>
        <span class="tape tile-tape" style="--tape-r:-1.5deg;width:240px" aria-hidden="true"></span>
        <div class="tile-clip">
          <img src="/images/dante-portrait.webp" alt="L Dante Guarin in an A's cap and white-framed glasses, holding up a sneaker." class="why-figure" width="879" height="1000" loading="eager" decoding="async" />
          <img src="/images/dante-portrait.webp" alt="" class="why-figure why-figure--lit" width="879" height="1000" loading="eager" decoding="async" aria-hidden="true" />
        </div>
        <div class="tile-inner max-w-6xl mx-auto px-6 md:px-8">
          <p class={eyebrow}>About me</p>
          <h2 class={`${h2} mb-6`}>20+ years in design</h2>
          <p class="why-copy text-lg md:text-xl leading-relaxed mb-5">
            I started as a web designer, designing and coding sites for the music industry, professional and consumer brands, and government agencies.
          </p>
          <p class="why-copy text-lg md:text-xl leading-relaxed mb-10 slide:mb-8">
            From there I moved into product design: med-tech, marketing tech, data, and B2B enterprise software.
          </p>
          <p class={`${eyebrow} mb-3`}>Trusted by</p>
          <ul class="why-clients">
            {clients.map((name) => <li>{name}</li>)}
            <li class="why-clients-more">and many more</li>
          </ul>
        </div>
      </section>

      <!-- EXPERTISE, with its four areas branching below it -->
      <section id="expertise" style="--c:4;--r:1;--dx:960px;--dy:-60px;--tilt:1.1deg" data-tile data-label="Expertise" class={`tile ${section}`} data-reveal>
        <span class="tape tile-tape" style="--tape-r:-2deg;width:240px" aria-hidden="true"></span>
        <div class="tile-inner max-w-6xl mx-auto px-6 md:px-8">
          <p class={eyebrow}>What I'm known for</p>
          <h2 class={`${h2} work-title mb-10`}>Expertise</h2>
          <ul class="grid sm:grid-cols-2 slide:grid-cols-4 gap-4 slide:gap-5">
            {workAreas.map((a) => (
              <li>
                <a href={`#${a.id}`} class="work-card">
                  <span class="work-card-title">{a.title}</span>
                  <span class="work-card-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {workAreas.map((a) => (
        <section id={a.id} style={a.pos} data-tile data-branch="expertise" data-label={a.title} class={`tile ${section}`} data-reveal>
          <span class="tape tile-tape" style={a.tape} aria-hidden="true"></span>
          <div class={`tile-inner max-w-6xl mx-auto px-6 md:px-8${a.shots ? ' work-split' : ''}`}>
            <div class="work-copy">
              <p class={eyebrow}>Expertise</p>
              <h2 class={`${h2} work-area-title mb-6`}>{a.title}</h2>
              {a.body ? (
                a.body.map((para) => <p class="work-body text-lg leading-relaxed mb-4">{para}</p>)
              ) : (
                <p class="text-lg md:text-xl leading-relaxed">Case studies coming soon.</p>
              )}
            </div>
            {a.shots && (
              <div class="work-gallery" data-gallery>
                {a.shots.map((s, k) => (
                  <figure class={`work-shot${k === 0 ? ' is-active' : ''}`}>
                    <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="eager" decoding="async" />
                  </figure>
                ))}
                {a.shots.length > 1 && (
                  <p class="work-gallery-count" aria-live="polite"><span data-gallery-index>1</span> / {a.shots.length}</p>
                )}
              </div>
            )}
          </div>
        </section>
      ))}

      <!-- Marker title over the slides on the whiteboard (desktop canvas only). -->
      <h2 class="board-title board-heading">Product &amp; Design</h2>

      <!-- PHOTOGRAPHY: prints taped to the board (not a slide, no connectors).
           Each links to its image, so it works without script; on the canvas
           a click glides in to the print and shows its title and caption. -->
      <section id="photography" class="board-photos" aria-labelledby="photography-title">
        <h2 id="photography-title" class="board-title">Photography</h2>
        <ul class="board-photo-list">
          {photos.map((p, i) => (
            <li class="board-print" style={`--x:${p.x}px;--y:${p.y}px;--w:${p.w}px;--r:${p.r}deg`}>
              <a class="board-photo" href={p.src} data-photo-index={i} data-title={p.title} data-caption={p.caption}>
                <span class="tape print-tape" aria-hidden="true"></span>
                <img src={p.src} alt={p.alt} width={p.iw} height={p.ih} loading="lazy" decoding="async" />
              </a>
              <p class="board-photo-caption"><strong>{p.title}</strong> {p.caption}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>
  </div>

  <!-- Title and caption for a print you've glided into (desktop canvas). -->
  <div id="photo-viewer" hidden aria-live="polite">
    <p class="photo-viewer-count"></p>
    <h3 class="photo-viewer-title"></h3>
    <p class="photo-viewer-caption"></p>
    <div class="photo-viewer-actions">
      <button type="button" class="btn btn--dark text-sm px-4 py-2" data-photo-prev>← Prev</button>
      <button type="button" class="btn btn--dark text-sm px-4 py-2" data-photo-next>Next →</button>
      <button type="button" class="btn text-sm px-4 py-2" data-photo-close>Back to the board</button>
    </div>
  </div>

  <script>
    // Why me: the photo sits at half strength; a spotlight follows the
    // pointer and lights it up to full, only on the photo's own pixels. The
    // position is set in percentages of the photo, so it lines up at any
    // canvas zoom.
    const whyMe = document.getElementById('why-me');
    const whyLit = whyMe?.querySelector('.why-figure--lit');
    if (whyMe && whyLit) {
      const pct = (v, start, size) => `${(((v - start) / size) * 100).toFixed(2)}%`;
      whyMe.addEventListener('pointermove', (e) => {
        const r = whyLit.getBoundingClientRect();
        whyLit.style.setProperty('--mx', pct(e.clientX, r.left, r.width));
        whyLit.style.setProperty('--my', pct(e.clientY, r.top, r.height));
        whyMe.classList.add('is-lit');
      });
      whyMe.addEventListener('pointerleave', () => whyMe.classList.remove('is-lit'));
    }

    // Links that leave the site (marked target="_blank") open in a new
    // tab explicitly, so they do even where a browser would otherwise
    // reuse the current one.
    document.querySelectorAll('a[target="_blank"]').forEach((link) => {
      link.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        const opened = window.open(link.href, '_blank');
        if (!opened) return; // blocked: fall back to the link's own target
        opened.opener = null; // same protection as rel="noopener"
        e.preventDefault();
      });
    });

    // Respect reduced motion: hold the street loop on a single frame.
    const heroVideo = document.querySelector('.hero-video');
    if (heroVideo && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      heroVideo.removeAttribute('autoplay');
      heroVideo.pause();
    }
  </script>
</Layout>
