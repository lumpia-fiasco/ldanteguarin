---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'L Dante Guarin — Product & Fractional Design for Startups',
  description = 'L Dante Guarin is a fractional design lead — design leadership, design systems and AI-assisted workflows for growing product teams. 20+ years in design. $3.1M+ saved, 10x market expansion.',
} = Astro.props;

const siteUrl = 'https://ldanteguarin.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'L Dante Guarin',
      jobTitle: 'Fractional Design Lead',
      url: siteUrl,
      email: 'mailto:hello@ldante.com',
      sameAs: ['https://linkedin.com/in/ldanteguarin', 'https://ldante.com'],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Los Angeles',
        addressRegion: 'CA',
        addressCountry: 'US',
      },
      knowsAbout: [
        'Product Design',
        'Design Systems',
        'AI-Assisted Design Workflows',
        'Design Leadership',
        'Enterprise SaaS',
      ],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#service`,
      name: 'L Dante Guarin — Fractional Design Leadership',
      url: siteUrl,
      description,
      provider: { '@id': `${siteUrl}/#person` },
      areaServed: 'US',
      serviceType: ['Fractional Design Leadership', 'Design Systems', 'Interim Design Leadership'],
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta name="theme-color" content="#1c1c1c" />
    <link rel="canonical" href={siteUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cal+Sans&family=Courier+Prime:wght@400;700&family=Permanent+Marker&family=Golos+Text:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('ldg-cases-unlocked')) document.documentElement.classList.add('cases-unlocked');
      } catch {}
    </script>
  </head>
  <body class="bg-charcoal text-neutral-400 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-pink focus:text-charcoal focus:font-semibold focus:px-4 focus:py-2 focus:rounded-full"
    >
      Skip to content
    </a>
    <slot />
    <div id="grain" aria-hidden="true"></div>
    <!-- The LDG mark, hung top-left on two strings (tied to the L and the G).
         Positioned by the physics loop at the end of the script below. -->
    <!-- First-visit hint: pinch to zoom around the whiteboard (desktop canvas). -->
    <div id="board-hint" role="status" hidden>
      <svg class="board-hint-icon" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M5 27 L13 19 M5 27 h6 M5 27 v-6 M27 5 L19 13 M27 5 h-6 M27 5 v6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>Pinch to zoom in and out <span class="board-hint-alt">· press <kbd>M</kbd> for the whole board</span></span>
      <button type="button" class="board-hint-close" aria-label="Dismiss hint">×</button>
    </div>
    <svg id="logo-strings" aria-hidden="true"><line /><line /></svg>
    <a id="site-logo" href="#main" aria-label="L Dante Guarin, home">
      <svg viewBox="0 0 400 200" aria-hidden="true">
        <path d="M0 0 L100 200 L0 200 Z" />
        <path d="M100 0 A100 100 0 0 1 100 200 Z" />
        <path d="M300 100 L300 0 A100 100 0 1 0 400 100 Z" />
      </svg>
    </a>
    {/* Zoom keys are parked for now (their styles and handlers are kept; the
       handlers skip missing buttons). Scroll, pinch and the M key still work.
    <div id="zoom-controls">
      <button type="button" id="zoom-in" aria-label="Zoom in">+</button>
      <button type="button" id="zoom-out" aria-label="Zoom out">−</button>
      <button type="button" id="zoom-map" aria-label="Show the whole map (M)">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2 2h5v5H2zM9 2h5v5H9zM2 9h5v5H2zM9 9h5v5H9z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      </button>
      <button type="button" id="zoom-reset" aria-label="Back to the top panel">⌂</button>
    </div>
    */}
    <script>
      import Panzoom from '@panzoom/panzoom';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canvasViewport = document.getElementById('canvas-viewport');
      const canvasGrid = document.getElementById('canvas-grid');
      const canvasMain = canvasGrid && canvasGrid.parentElement;
      // Same breakpoint as the canvas CSS. The canvas switches on and off
      // live when the window crosses it, not just at page load.
      const desktop = window.matchMedia('(min-width: 901px)');
      const canvasOn = () => !!panzoom;
      let panzoom = null;

      // Scroll-reveal for the mobile page (the canvas CSS shows everything
      // regardless); no-JS and reduced-motion always show everything.
      const els = document.querySelectorAll('[data-reveal]');
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.setAttribute('data-revealed', 'true');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.setAttribute('data-revealed', 'true'));
      }

      const tileOrder = canvasGrid ? Array.from(canvasGrid.querySelectorAll('[data-tile]')) : [];
      const heroTile = document.getElementById('hero');
      let currentIndex = 0;

      // ── Geometry ──
      // Panzoom's transform is `scale(s) translate(tx, ty)` about the grid's
      // centre, so a view is the canvas point at the middle of the viewport
      // plus a scale. Tile positions come from offsetLeft/Top, which are
      // grid-local (and ignore the transform) because the grid is
      // position:relative.
      const vpSize = () => ({ w: canvasViewport.clientWidth, h: canvasViewport.clientHeight });
      function stateFor(c, s) {
        const v = vpSize();
        const W = canvasGrid.offsetWidth;
        const H = canvasGrid.offsetHeight;
        return { s, tx: (v.w / 2 - W / 2) / s + W / 2 - c.x, ty: (v.h / 2 - H / 2) / s + H / 2 - c.y };
      }
      function centerOf(s, tx, ty) {
        const v = vpSize();
        const W = canvasGrid.offsetWidth;
        const H = canvasGrid.offsetHeight;
        return { x: (v.w / 2 - W / 2) / s + W / 2 - tx, y: (v.h / 2 - H / 2) / s + H / 2 - ty };
      }
      // Where a slide lands: centred and scaled so the slide fills the window.
      // Slides take the window's proportions (1440 wide, height to match), so
      // a landed slide fills the screen edge to edge without cropping.
      const SLIDE_W = 1440;
      function matchSlideAspect() {
        const v = vpSize();
        // No upper limit: capping the height made squarer windows crop the
        // slide's sides. Only ultra-wide windows (past ~2.5:1) bottom out.
        const h = Math.round(Math.max(560, (SLIDE_W * v.h) / v.w));
        canvasGrid.style.setProperty('--slide-h', `${h}px`);
      }
      // Cover-fit, so the sheet always reaches every edge of the window.
      function frameFor(t) {
        const v = vpSize();
        const s = Math.min(3, Math.max(0.3, Math.max(v.w / t.offsetWidth, v.h / t.offsetHeight)));
        return { s, c: { x: t.offsetLeft + t.offsetWidth / 2, y: t.offsetTop + t.offsetHeight / 2 } };
      }

      // Every slide, fitted to the window — the map view.
      function overview() {
        let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
        // Everything on the board: slides, the photo wall and marker titles.
        const boardExtras = Array.from(canvasGrid.querySelectorAll('.board-photos, .board-heading'));
        [...tileOrder, ...boardExtras].forEach((t) => {
          minX = Math.min(minX, t.offsetLeft);
          minY = Math.min(minY, t.offsetTop);
          maxX = Math.max(maxX, t.offsetLeft + t.offsetWidth);
          maxY = Math.max(maxY, t.offsetTop + t.offsetHeight);
        });
        const v = vpSize();
        const m = 60;
        return {
          s: Math.min((v.w - 2 * m) / (maxX - minX), (v.h - 2 * m) / (maxY - minY)),
          c: { x: (minX + maxX) / 2, y: (minY + maxY) / 2 },
        };
      }

      // Slides are a fixed size; if a slide's content runs taller than the
      // slide, shrink that content to fit instead of letting it spill.
      function fitSlides() {
        tileOrder.forEach((t) => {
          const inner = t.querySelector(':scope > .tile-inner');
          // Briefcase slides lay their content out against the photo, so they
          // are never zoomed (that would pull it off the pocket and the case).
          if (!inner || t.classList.contains('case-tile') || inner.classList.contains('case-open')) return;
          inner.style.zoom = '';
          const cs = getComputedStyle(t);
          const avail = t.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
          const need = inner.scrollHeight;
          if (need > avail) inner.style.zoom = String(Math.max(0.6, avail / need));
        });
      }
      function unfitSlides() {
        tileOrder.forEach((t) => {
          const inner = t.querySelector(':scope > .tile-inner');
          if (inner) inner.style.zoom = '';
        });
      }
      // Force the DOM transform to match Panzoom's logical state (Panzoom
      // writes inside requestAnimationFrame and no-ops on unchanged values).
      function settleInstantly() {
        const p = panzoom.getPan();
        const s = panzoom.getScale();
        canvasGrid.style.transition = 'none';
        canvasGrid.style.transform = `scale(${s}) translate(${p.x}px, ${p.y}px)`;
      }
      // Hand a finished view back to Panzoom so drag/zoom continue from it.
      function commit(st) {
        panzoom.zoom(st.s, { animate: false });
        panzoom.pan(st.tx, st.ty, { animate: false });
        settleInstantly();
      }

      // ── Zoom-out / zoom-in navigation ──
      let anim = null;
      const easeInOut = (u) => (u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);

      function cancelAnim() {
        if (!anim) return;
        cancelAnimationFrame(anim.raf);
        const last = anim.last;
        anim = null;
        canvasMain.style.transform = '';
        canvasMain.style.willChange = '';
        if (last) commit(last);
      }

      function animateTo(tile, instant) {
        if (photoIndex !== -1) closePhoto(false);
        const idx = tileOrder.indexOf(tile);
        if (idx !== -1) currentIndex = idx;
        const { s: s1, c: g1 } = frameFor(tile);
        animateView(g1, s1, instant, true);
      }

      function showMap() {
        dismissHint(true);
        if (photoIndex !== -1) closePhoto(false);
        const { s: s1, c: g1 } = overview();
        animateView(g1, s1, false, false);
      }
      // Glide the view to canvas point g1 at scale s1. withTilt adds the
      // arrival swing used for slide-to-slide jumps.
      function animateView(g1, s1, instant, withTilt) {
        cancelAnim();
        stopZoom();
        const end = stateFor(g1, s1);
        if (instant || reduceMotion) {
          commit(end);
          return;
        }
        const s0 = panzoom.getScale();
        const p0 = panzoom.getPan();
        const c0 = centerOf(s0, p0.x, p0.y);
        if (Math.hypot(c0.x - g1.x, c0.y - g1.y) < 2 && Math.abs(s0 - s1) < 0.01) return;

        // A gentle glide rather than a hop: the view pulls back only slightly
        // (a little more for longer trips) and heads straight for the target.
        // As the new slide comes in it swings in at an angle and straightens
        // as it lands. The tilt goes on #main, whose centre is the viewport's
        // — rotating the grid would pivot about the whole canvas.
        const dist = Math.hypot(g1.x - c0.x, g1.y - c0.y);
        const dip = 0.12 + 0.1 * Math.min(1, dist / 5000);
        const lean = withTilt ? (g1.x >= c0.x ? 1 : -1) * 2.4 : 0;
        // Zooming out to the map shouldn't dip further first.
        const dipAmt = s1 < s0 ? 0 : dip;
        const duration = 1150;
        const t0 = performance.now();
        anim = { raf: 0, last: null };
        canvasMain.style.willChange = 'transform';
        const frame = (now) => {
          const u = Math.min(1, (now - t0) / duration);
          const e = easeInOut(u);
          const b = Math.sin(Math.PI * u);
          const s = Math.exp(Math.log(s0) + (Math.log(s1) - Math.log(s0)) * e - dipAmt * b);
          const c = { x: c0.x + (g1.x - c0.x) * e, y: c0.y + (g1.y - c0.y) * e };
          const st = stateFor(c, s);
          // Arrival tilt: one smooth swing in the second half — eases in from
          // 0 and settles back to 0 with no wobble (sin² has zero slope at
          // both ends).
          const a = Math.min(1, Math.max(0, (u - 0.35) / 0.65));
          const tilt = lean * Math.sin(Math.PI * a) ** 2;
          canvasGrid.style.transition = 'none';
          canvasGrid.style.transform = `scale(${st.s}) translate(${st.tx}px, ${st.ty}px)`;
          canvasMain.style.transform = u < 1 ? `rotate(${tilt}deg)` : '';
          anim.last = st;
          if (u < 1) {
            anim.raf = requestAnimationFrame(frame);
          } else {
            anim = null;
            canvasMain.style.willChange = '';
            commit(end);
          }
        };
        anim.raf = requestAnimationFrame(frame);
      }

      // ── Smooth zoom ──
      // Pinch, Ctrl/Cmd+wheel, the +/- buttons and keys all set a target
      // scale; a slightly under-damped spring carries the view there, so
      // zooming glides and lands with a small bounce instead
      // of snapping. The point under the cursor (or the window centre) stays
      // put while it zooms.
      const ZOOM_MIN = 0.1;
      const ZOOM_MAX = 2.5;
      let zoomSpring = null;

      function stopZoom() {
        if (!zoomSpring) return;
        cancelAnimationFrame(zoomSpring.raf);
        zoomSpring = null;
      }
      function zoomBy(factor, clientX, clientY) {
        dismissHint(true);
        cancelAnim();
        const from = zoomSpring ? zoomSpring.target : panzoom.getScale();
        const target = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, from * factor));
        const focal = { clientX, clientY };
        if (reduceMotion) {
          panzoom.zoomToPoint(target, focal, { animate: false });
          settleInstantly();
          return;
        }
        if (zoomSpring) {
          zoomSpring.target = target;
          zoomSpring.focal = focal;
          return;
        }
        zoomSpring = { target, focal, v: 0, s: panzoom.getScale(), last: performance.now(), raf: 0 };
        const step = (now) => {
          const z = zoomSpring;
          if (!z) return;
          const dt = Math.min(0.032, (now - z.last) / 1000);
          z.last = now;
          // Spring in log-scale so zooming in and out feel the same.
          const x = Math.log(z.s);
          const goal = Math.log(z.target);
          const stiffness = 170;
          const damping = 14; // ratio ≈ 0.54: one visible overshoot, then settles
          z.v += (stiffness * (goal - x) - damping * z.v) * dt;
          const next = Math.exp(x + z.v * dt);
          z.s = next;
          panzoom.zoomToPoint(next, z.focal, { animate: false });
          settleInstantly();
          if (Math.abs(goal - Math.log(next)) < 0.0005 && Math.abs(z.v) < 0.001) {
            panzoom.zoomToPoint(z.target, z.focal, { animate: false });
            settleInstantly();
            zoomSpring = null;
            return;
          }
          z.raf = requestAnimationFrame(step);
        };
        zoomSpring.raf = requestAnimationFrame(step);
      }
      function zoomAtCenter(factor) {
        const r = canvasViewport.getBoundingClientRect();
        zoomBy(factor, r.left + r.width / 2, r.top + r.height / 2);
      }

      // ── Connectors + edge signposts ──
      // Dotted curves join the panels in reading order. They're drawn once,
      // in canvas space, inside the grid — so they pan and zoom rigidly with
      // the panels. Separately, when a neighbouring panel is off-screen, a
      // signpost pill sits on the screen edge in the direction of that panel.
      const SVG_NS = 'http://www.w3.org/2000/svg';
      const MARKER_RED = '#c3282c';
      // The main site in reading order, plus branch slides hanging off
      // their parent panel.
      const chain = (list) => list.slice(1).map((t, i) => [list[i], t]);
      const mainChain = tileOrder.filter((t) => !t.dataset.branch);
      // Branch slides (data-branch="<parent id>") each get their own line
      // straight from their parent, fanning out, rather than a chain.
      const branchPairs = tileOrder
        .filter((t) => t.dataset.branch)
        .map((t) => [document.getElementById(t.dataset.branch), t])
        .filter(([hub]) => hub);
      const pairs = [...chain(mainChain), ...branchPairs];
      let overlay = null;
      let lineLayer = null;
      let links = [];
      let posts = new Map();
      let hotTile = null;
      let overlayRaf = 0;

      function buildOverlay() {
        lineLayer = document.createElementNS(SVG_NS, 'svg');
        lineLayer.id = 'canvas-lines';
        lineLayer.setAttribute('aria-hidden', 'true');
        // Arrowheads don't inherit the line's colour, so there's one per ink.
        const head = (id, ink) =>
          `<marker id="${id}" viewBox="0 0 20 20" refX="15" refY="10" markerWidth="8" markerHeight="8" orient="auto-start-reverse" markerUnits="strokeWidth">` +
          `<path d="M2.5 2.5 L16 10 L3 17.5" fill="none" stroke="${ink}" stroke-width="2.6" stroke-linecap="butt" stroke-linejoin="miter"/></marker>`;
        lineLayer.innerHTML = `<defs>${head('marker-arrow', MARKER_RED)}${head('marker-arrow-hot', '#f2a0b5')}</defs>`;
        links = pairs.map(([a, b]) => {
          const path = document.createElementNS(SVG_NS, 'path');
          path.setAttribute('class', 'connector');
          // A thin, broken lighter line over the stroke: the streaks a
          // half-dry whiteboard marker leaves.
          const streak = document.createElementNS(SVG_NS, 'path');
          streak.setAttribute('class', 'connector-streak');
          const ends = [0, 1].map(() => {
            const dot = document.createElementNS(SVG_NS, 'circle');
            dot.setAttribute('class', 'connector-end');
            dot.setAttribute('r', '5');
            return dot;
          });
          lineLayer.append(path, streak, ...ends);
          return { a, b, path, streak, ends };
        });
        canvasGrid.prepend(lineLayer);
        layoutConnectors();
        tileOrder.forEach((t) => {
          const label = document.createElement('span');
          label.className = 'slide-title';
          label.setAttribute('aria-hidden', 'true');
          // Marker on a strip of masking tape, like the hero title.
          const strip = document.createElement('span');
          strip.className = 'tape';
          strip.textContent = t.dataset.label;
          label.appendChild(strip);
          t.appendChild(label);
        });

        overlay = document.createElement('div');
        overlay.id = 'canvas-overlay';
        const dock = document.createElement('nav');
        dock.id = 'signpost-dock';
        dock.setAttribute('aria-label', 'Nearby sections');
        overlay.appendChild(dock);
        posts = new Map();
        tileOrder.forEach((tile) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'signpost';
          btn.hidden = true;
          btn.setAttribute('aria-label', `Go to ${tile.dataset.label}`);
          btn.innerHTML =
            '<span class="signpost-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>' +
            '<span class="signpost-text"><span class="signpost-kicker"></span><span class="signpost-label"></span></span>';
          btn.querySelector('.signpost-label').textContent = tile.dataset.label;
          btn.addEventListener('click', () => animateTo(tile, false));
          btn.addEventListener('pointerenter', () => setHot(tile));
          btn.addEventListener('pointerleave', () => setHot(null));
          btn.addEventListener('focus', () => setHot(tile));
          btn.addEventListener('blur', () => setHot(null));
          dock.appendChild(btn);
          posts.set(tile, { btn, x: 0, y: 0, placed: false });
        });
        canvasViewport.appendChild(overlay);
        overlayRaf = requestAnimationFrame(drawOverlay);
      }
      function destroyOverlay() {
        cancelAnimationFrame(overlayRaf);
        overlay?.remove();
        lineLayer?.remove();
        document.querySelectorAll('.slide-title').forEach((el) => el.remove());
        canvasGrid.classList.remove('is-overview');
        canvasGrid.style.removeProperty('--zo');
        lastZo = -1;
        counterTile = null;
        overlay = null;
        lineLayer = null;
        hotTile = null;
      }
      // Hovering a signpost lights up the line from the panel you're on to
      // the one it points at.
      function setHot(tile) {
        hotTile = tile;
        const from = tile && posts.get(tile)?.near;
        links.forEach((L) => {
          const hot = !!from && ((L.a === tile && L.b === from) || (L.b === tile && L.a === from));
          L.path.classList.toggle('is-hot', hot);
          L.path.setAttribute('marker-end', hot ? 'url(#marker-arrow-hot)' : 'url(#marker-arrow)');
        });
      }

      // Where a ray from a rect's centre toward point p crosses its edge,
      // plus the outward normal of that side.
      function exitPoint(r, p) {
        const cx = r.x + r.w / 2;
        const cy = r.y + r.h / 2;
        const dx = p.x - cx;
        const dy = p.y - cy;
        const tx = dx === 0 ? Infinity : (r.w / 2) / Math.abs(dx);
        const ty = dy === 0 ? Infinity : (r.h / 2) / Math.abs(dy);
        const t = Math.min(tx, ty);
        return tx < ty
          ? { x: cx + dx * t, y: cy + dy * t, nx: Math.sign(dx), ny: 0 }
          : { x: cx + dx * t, y: cy + dy * t, nx: 0, ny: Math.sign(dy) };
      }
      const canvasRect = (t) => ({ x: t.offsetLeft, y: t.offsetTop, w: t.offsetWidth, h: t.offsetHeight });

      // Static curves between facing panel edges, in canvas coordinates.
      function layoutConnectors() {
        if (!lineLayer) return;
        lineLayer.setAttribute('width', canvasGrid.offsetWidth);
        lineLayer.setAttribute('height', canvasGrid.offsetHeight);
        links.forEach((L) => {
          const ra = canvasRect(L.a);
          const rb = canvasRect(L.b);
          const pa = exitPoint(ra, { x: rb.x + rb.w / 2, y: rb.y + rb.h / 2 });
          const pb = exitPoint(rb, { x: ra.x + ra.w / 2, y: ra.y + ra.h / 2 });
          const k = Math.min(Math.hypot(pb.x - pa.x, pb.y - pa.y) * 0.45, 280);
          // Stand the line off the paper a little, then trace the curve with
          // a slight hand-drawn wobble, like a marker stroke.
          const gap = 36;
          const p0 = { x: pa.x + pa.nx * gap, y: pa.y + pa.ny * gap };
          const p3 = { x: pb.x + pb.nx * gap, y: pb.y + pb.ny * gap };
          const p1 = { x: p0.x + pa.nx * k, y: p0.y + pa.ny * k };
          const p2 = { x: p3.x + pb.nx * k, y: p3.y + pb.ny * k };
          const pts = [];
          const n = 28;
          for (let i = 0; i <= n; i++) {
            const t = i / n, u = 1 - t;
            const x = u * u * u * p0.x + 3 * u * u * t * p1.x + 3 * u * t * t * p2.x + t * t * t * p3.x;
            const y = u * u * u * p0.y + 3 * u * u * t * p1.y + 3 * u * t * t * p2.y + t * t * t * p3.y;
            const w = Math.sin(t * Math.PI) * (Math.sin(t * 9.1 + 1.3) * 5 + Math.sin(t * 23.7) * 2);
            pts.push(`${(x + w * 0.6).toFixed(1)} ${(y + w).toFixed(1)}`);
          }
          L.path.setAttribute('d', `M${pts.join('L')}`);
          L.streak.setAttribute('d', `M${pts.join('L')}`);
          L.path.setAttribute('marker-end', 'url(#marker-arrow)');
          pa.x = p0.x; pa.y = p0.y;
          [pa, pb].forEach((p, i) => {
            L.ends[i].setAttribute('cx', p.x);
            L.ends[i].setAttribute('cy', p.y);
          });
        });
      }

      function clipRect(r, W, H) {
        const x0 = Math.max(r.x, 0);
        const y0 = Math.max(r.y, 0);
        const x1 = Math.min(r.x + r.w, W);
        const y1 = Math.min(r.y + r.h, H);
        return x1 - x0 > 80 && y1 - y0 > 80 ? { x: x0, y: y0, w: x1 - x0, h: y1 - y0 } : null;
      }

      // Signposts: for each neighbouring pair with one panel on screen and
      // the other off it, a pill for the hidden panel appears in a fixed
      // stack in the bottom-right corner (Case study / Next / Back, top to
      // bottom). Its arrow still points toward the panel, snapped to eight
      // directions.
      const KICKER_ORDER = { Explore: 1, Next: 2, Back: 3 };
      let lastZo = -1;
      let lastTz = -1;
      let counterTile = null;
      const counterNum = document.querySelector('[data-counter-num]');
      const counterLabel = document.querySelector('[data-counter-label]');
      function updateCounter(t) {
        if (!counterNum) return;
        const cases = tileOrder.filter((x) => x.dataset.branch === 'cases');
        const pad = (n) => String(n).padStart(2, '0');
        if (t.dataset.branch === 'cases') {
          counterNum.textContent = `CS ${cases.indexOf(t) + 1}/${cases.length}`;
        } else {
          counterNum.textContent = `${pad(mainChain.indexOf(t) + 1)}/${pad(mainChain.length)}`;
        }
        counterLabel.textContent = t.dataset.label.toUpperCase();
      }
      function drawOverlay() {
        overlayRaf = requestAnimationFrame(drawOverlay);
        if (!overlay) return;
        const vp = canvasViewport.getBoundingClientRect();
        const W = vp.width;
        const H = vp.height;
        const rects = new Map(
          tileOrder.map((t) => {
            const b = t.getBoundingClientRect();
            return [t, { x: b.left - vp.left, y: b.top - vp.top, w: b.width, h: b.height }];
          })
        );
        const visible = new Map(tileOrder.map((t) => [t, clipRect(rects.get(t), W, H)]));
        const wanted = new Map();

        // How far zoomed out we are (0 at reading zoom, 1 at map zoom). Slides
        // gain a surface and big titles as you pull back.
        const sNow = anim && anim.last ? anim.last.s : panzoom.getScale();
        const zo = Math.min(1, Math.max(0, (0.6 - sNow) / (0.6 - 0.3)));
        if (Math.abs(zo - lastZo) > 0.005 || (zo === 0) !== (lastZo === 0)) {
          canvasGrid.style.setProperty('--zo', zo.toFixed(3));
          lastZo = zo;
        }
        // Tilt factor: 0 at the landed slide's framing, 1 once pulled back
        // about a third, so slides loosen as soon as you leave one.
        const sLand = frameFor(tileOrder[currentIndex] || heroTile).s;
        const tz = Math.min(1, Math.max(0, (sLand * 0.985 - sNow) / (sLand * 0.3)));
        if (Math.abs(tz - lastTz) > 0.004) {
          canvasGrid.style.setProperty('--tz', tz.toFixed(3));
          lastTz = tz;
        }
        // Out over the white board the pink logo would wash out, so it
        // switches to dark charcoal, and back to pink as a slide lands.
        document.documentElement.classList.toggle('on-board', tz > 0.3 || photoIndex !== -1);
        const overviewNow = sNow < 0.45;
        if (overviewNow !== canvasGrid.classList.contains('is-overview')) canvasGrid.classList.toggle('is-overview', overviewNow);

        // Slide counter: the slide nearest the middle of the window.
        let nearest = null;
        let best = Infinity;
        rects.forEach((r, t) => {
          const d = Math.hypot(r.x + r.w / 2 - W / 2, r.y + r.h / 2 - H / 2);
          if (d < best) {
            best = d;
            nearest = t;
          }
        });
        const counterKey = overviewNow ? 'map' : nearest;
        if (counterKey && counterKey !== counterTile) {
          counterTile = counterKey;
          if (!counterNum) {
            // no counter on the page
          } else if (overviewNow) {
            counterNum.textContent = 'MAP';
            counterLabel.textContent = `${tileOrder.length} SLIDES`;
          } else {
            updateCounter(nearest);
          }
        }

        pairs.forEach(([a, b]) => {
          const va = visible.get(a);
          const vb = visible.get(b);
          if (!va === !vb) return;
          const [near, far] = va ? [a, b] : [b, a];
          if (wanted.has(far)) return;
          const nr = visible.get(near);
          const fr = rects.get(far);
          const dx = fr.x + fr.w / 2 - (nr.x + nr.w / 2);
          const dy = fr.y + fr.h / 2 - (nr.y + nr.h / 2);
          const angle = Math.round(Math.atan2(dy, dx) / (Math.PI / 4)) * 45;
          const forward = tileOrder.indexOf(far) > tileOrder.indexOf(near);
          const kicker = !forward ? 'Back' : far.dataset.branch ? 'Explore' : 'Next';
          wanted.set(far, { angle, kicker, near });
        });

        const moving = !!anim;
        posts.forEach((p, tile) => {
          const sp = wanted.get(tile);
          if (!sp || moving) {
            if (!p.btn.hidden) p.btn.hidden = true;
            p.key = null;
            if (hotTile === tile && !sp) setHot(null);
            return;
          }
          p.near = sp.near;
          const key = `${sp.kicker}|${sp.angle}`;
          if (key === p.key) return; // nothing changed: leave the DOM alone
          const appearing = p.btn.hidden;
          p.key = key;
          p.btn.querySelector('.signpost-kicker').textContent = sp.kicker;
          p.btn.style.order = String(KICKER_ORDER[sp.kicker]);
          p.btn.style.setProperty('--arrow-angle', `${sp.angle}deg`);
          p.btn.hidden = false;
          if (appearing && !reduceMotion) {
            p.btn.getAnimations().forEach((an) => an.id === 'grow' && an.cancel());
            p.btn.animate(
              [
                { scale: 0.35, opacity: 0 },
                { scale: 1, opacity: 1 },
              ],
              { id: 'grow', duration: 480, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
            );
          }
        });
      }

      // ── Whiteboard ──
      // The canvas background is a whiteboard, synced to the canvas each
      // frame so it pans and zooms with the slides. Slides sit on it loosely:
      // each has its own nudge off the grid and a slight tilt (set per slide
      // in index.astro) and a strip of tape at the top. The tilt eases in as
      // you pull back from a slide and straightens as one lands, so a landed
      // slide still fills the window square.
      let boardRaf = 0;
      function syncBoard() {
        boardRaf = requestAnimationFrame(syncBoard);
        const r = canvasGrid.getBoundingClientRect();
        const s = r.width / canvasGrid.offsetWidth;
        canvasViewport.style.setProperty('--board-x', `${r.left.toFixed(1)}px`);
        canvasViewport.style.setProperty('--board-y', `${r.top.toFixed(1)}px`);
        canvasViewport.style.setProperty('--board-size', `${(1024 * s).toFixed(1)}px`);
      }

      // ── Photography ──
      // Prints taped to the board below the slides. Clicking one glides in
      // until it fills the space above the caption card, straightens it, and
      // shows its title and caption; Prev/Next (or the arrow keys) step
      // through them, and Back (or Esc) returns to the whole board. Without
      // the canvas (phones) the links just open the image.
      const photoLinks = Array.from(document.querySelectorAll('.board-photo'));
      const viewer = document.getElementById('photo-viewer');
      let photoIndex = -1;
      function photoRect(link) {
        const print = link.closest('.board-print');
        const wall = print.offsetParent;
        return { x: wall.offsetLeft + print.offsetLeft, y: wall.offsetTop + print.offsetTop, w: print.offsetWidth, h: print.offsetHeight };
      }
      function openPhoto(i) {
        if (!canvasOn() || !viewer || !photoLinks.length) return;
        photoIndex = (i + photoLinks.length) % photoLinks.length;
        const link = photoLinks[photoIndex];
        photoLinks.forEach((l) => l.closest('.board-print').classList.toggle('is-focused', l === link));
        const r = photoRect(link);
        const v = vpSize();
        const top = 96, bottom = 250, side = 96;
        const s = Math.min(2.5, (v.w - 2 * side) / r.w, (v.h - top - bottom) / r.h);
        animateView({ x: r.x + r.w / 2, y: r.y + r.h / 2 - (top - bottom) / 2 / s }, s, false, true);
        viewer.querySelector('.photo-viewer-count').textContent = `Photography · ${photoIndex + 1} / ${photoLinks.length}`;
        viewer.querySelector('.photo-viewer-title').textContent = link.dataset.title;
        viewer.querySelector('.photo-viewer-caption').textContent = link.dataset.caption;
        viewer.hidden = false;
      }
      function closePhoto(toBoard) {
        photoIndex = -1;
        photoLinks.forEach((l) => l.closest('.board-print').classList.remove('is-focused'));
        if (viewer) viewer.hidden = true;
        if (toBoard) showMap();
      }
      photoLinks.forEach((link, i) =>
        link.addEventListener('click', (e) => {
          if (!canvasOn()) return;
          e.preventDefault();
          openPhoto(i);
        })
      );
      viewer?.querySelector('[data-photo-prev]').addEventListener('click', () => openPhoto(photoIndex - 1));
      viewer?.querySelector('[data-photo-next]').addEventListener('click', () => openPhoto(photoIndex + 1));
      viewer?.querySelector('[data-photo-close]').addEventListener('click', () => closePhoto(true));
      document.addEventListener(
        'keydown',
        (e) => {
          if (photoIndex === -1) return;
          const act = { Escape: () => closePhoto(true), ArrowRight: () => openPhoto(photoIndex + 1), ArrowLeft: () => openPhoto(photoIndex - 1) }[e.key];
          if (!act) return;
          e.preventDefault();
          e.stopImmediatePropagation();
          act();
        },
        true
      );
      // Dragging the board away from an open print puts its caption away.
      let photoDown = null;
      canvasViewport?.addEventListener('pointerdown', (e) => { photoDown = { x: e.clientX, y: e.clientY }; }, true);
      canvasViewport?.addEventListener('pointerup', (e) => {
        if (photoIndex === -1 || !photoDown) return;
        if (Math.hypot(e.clientX - photoDown.x, e.clientY - photoDown.y) > 8) closePhoto(false);
        photoDown = null;
      });

      // ── Board hint ──
      // On load, a small pill tells first-timers they can pinch to zoom in
      // and out (and press M for the whole whiteboard). It leaves when they pinch,
      // zoom, open the map, dismiss it, or after a few seconds; once they've
      // actually used it, it stays away on later visits.
      const hint = document.getElementById('board-hint');
      const HINT_KEY = 'ldg-board-hint-done';
      let hintTimer = 0;
      const hintDone = () => {
        try {
          return localStorage.getItem(HINT_KEY) === '1';
        } catch {
          return false;
        }
      };
      function showHintSoon() {
        if (!hint || hintDone()) return;
        clearTimeout(hintTimer);
        hintTimer = setTimeout(() => {
          if (!canvasOn() || hintDone()) return;
          hint.hidden = false;
          requestAnimationFrame(() => hint.classList.add('is-in'));
          hintTimer = setTimeout(() => dismissHint(false), 7000);
        }, 2200);
      }
      function dismissHint(remember) {
        if (remember) {
          try {
            localStorage.setItem(HINT_KEY, '1');
          } catch {}
        }
        clearTimeout(hintTimer);
        if (!hint || hint.hidden) return;
        hint.classList.remove('is-in');
        setTimeout(() => { hint.hidden = true; }, reduceMotion ? 0 : 300);
      }
      hint?.querySelector('.board-hint-close').addEventListener('click', () => dismissHint(true));
      // Safari reports trackpad pinches as gesture events.
      window.addEventListener('gesturestart', () => dismissHint(true));

      // ── Switching the canvas on and off ──
      function enableCanvas() {
        if (canvasOn() || !canvasGrid) return;
        panzoom = Panzoom(canvasGrid, {
          canvas: true,
          cursor: 'grab',
          minScale: 0.05,
          maxScale: 3,
          animate: !reduceMotion,
          duration: 300,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        });
        matchSlideAspect();
        syncBoard();
        // Lazy-loading can't tell what's on screen through the canvas
        // transform, so the board's prints load up front.
        photoLinks.forEach((l) => { const img = l.querySelector('img'); if (img) img.loading = 'eager'; });
        buildOverlay();
        document.fonts.ready.then(() => requestAnimationFrame(() => requestAnimationFrame(() => {
          if (canvasOn()) {
            fitSlides();
            layoutConnectors();
            animateTo(tileOrder[currentIndex] || heroTile, true);
            showHintSoon();
          }
        })));
      }
      function disableCanvas() {
        if (!canvasOn()) return;
        cancelAnim();
        stopZoom();
        destroyOverlay();
        cancelAnimationFrame(boardRaf);
        canvasGrid.style.removeProperty('--tz');
        dismissHint(false);
        document.documentElement.classList.remove('on-board');
        closePhoto(false);
        panzoom.destroy();
        panzoom = null;
        canvasGrid.style.transform = '';
        canvasGrid.style.transition = '';
        canvasMain.style.transform = '';
        canvasMain.style.cursor = '';
        canvasGrid.style.removeProperty('--slide-h');
        unfitSlides();
      }
      if (canvasViewport && canvasGrid) {
        if (desktop.matches) enableCanvas();
        desktop.addEventListener('change', (e) => (e.matches ? enableCanvas() : disableCanvas()));

        // Scroll steps between panels: one gesture (a wheel flick or a
        // trackpad swipe, down/right for next, up/left for back) makes one
        // animated jump. A gesture only counts once, so a trackpad's
        // momentum tail can't skip ahead: it has to go quiet before the next
        // one arms. A slide with an image gallery flips through its images
        // before moving on. With a photo open, scrolling steps through photos;
        // in the map view it dives back into the panel you came from.
        // Ctrl/Cmd+wheel (also how browsers report a trackpad pinch) still
        // zooms at the pointer, and dragging still pans freely.
        let wheelAcc = 0;
        let wheelLastAt = 0;
        let wheelArmed = true;
        let wheelLockUntil = 0;
        canvasViewport.addEventListener(
          'wheel',
          (e) => {
            if (!canvasOn()) return;
            // Over a case write-up that can still scroll this way, let it
            // scroll instead of panning the canvas.
            const scroller = !e.ctrlKey && e.target.closest && e.target.closest('.case-scroll');
            if (scroller && Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
              const canScroll = e.deltaY > 0
                ? scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1
                : scroller.scrollTop > 0;
              if (canScroll) return;
            }
            e.preventDefault();
            if (e.ctrlKey) {
              // Trackpad pinches send small deltas; mouse wheels send big
              // notches — clamp so one notch is a comfortable step.
              const d = Math.max(-40, Math.min(40, e.deltaMode === 1 ? e.deltaY * 16 : e.deltaY));
              zoomBy(Math.exp(-d * 0.008), e.clientX, e.clientY);
              return;
            }
            const now = performance.now();
            if (now - wheelLastAt > 220) {
              // A fresh gesture after a quiet gap.
              wheelArmed = true;
              wheelAcc = 0;
            }
            wheelLastAt = now;
            if (!wheelArmed || now < wheelLockUntil) return;
            const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? vpSize().h : 1;
            const d = (Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX) * unit;
            wheelAcc += d;
            if (Math.abs(wheelAcc) < 40) return;
            const dir = Math.sign(wheelAcc);
            wheelAcc = 0;
            wheelArmed = false;
            wheelLockUntil = now + 900;
            if (photoIndex !== -1) {
              openPhoto(photoIndex + dir);
              return;
            }
            if (canvasGrid.classList.contains('is-overview')) {
              animateTo(tileOrder[currentIndex] || heroTile, false);
              return;
            }
            // A slide with an image gallery flips through its images first.
            const gallery = tileOrder[currentIndex]?.querySelector('[data-gallery]');
            if (gallery) {
              const shots = Array.from(gallery.querySelectorAll('.work-shot'));
              const at = shots.findIndex((s) => s.classList.contains('is-active'));
              const to = at + dir;
              if (at !== -1 && to >= 0 && to < shots.length) {
                shots.forEach((s, k) => s.classList.toggle('is-active', k === to));
                const count = gallery.querySelector('[data-gallery-index]');
                if (count) count.textContent = String(to + 1);
                return;
              }
            }
            const next = tileOrder[currentIndex + dir];
            if (next) animateTo(next, false);
          },
          { passive: false }
        );

        // Grabbing the canvas mid-flight takes over from the animation.
        canvasViewport.addEventListener('pointerdown', () => canvasOn() && cancelAnim(), true);

        // Keyboard: arrow keys pan, +/- zoom, 0 returns to the hero — only
        // when the viewport itself has focus, so this never fights a nested
        // control's own arrow-key behavior (like the "find your fit" tablist).
        canvasViewport.addEventListener('keydown', (e) => {
          if (!canvasOn() || document.activeElement !== canvasViewport) return;
          const step = 80;
          const scale = panzoom.getScale();
          const pan = (x, y) => {
            cancelAnim();
            panzoom.pan(x / scale, y / scale, { relative: true, animate: !reduceMotion });
          };
          const actions = {
            ArrowUp: () => pan(0, step),
            ArrowDown: () => pan(0, -step),
            ArrowLeft: () => pan(step, 0),
            ArrowRight: () => pan(-step, 0),
            '+': () => zoomAtCenter(1.3),
            '=': () => zoomAtCenter(1.3),
            '-': () => zoomAtCenter(1 / 1.3),
            _: () => zoomAtCenter(1 / 1.3),
            '0': () => animateTo(heroTile, false),
          };
          if (actions[e.key]) {
            e.preventDefault();
            actions[e.key]();
          }
        });

        document.getElementById('zoom-in')?.addEventListener('click', () => canvasOn() && zoomAtCenter(1.3));
        document.getElementById('zoom-out')?.addEventListener('click', () => canvasOn() && zoomAtCenter(1 / 1.3));
        document.getElementById('zoom-reset')?.addEventListener('click', () => canvasOn() && animateTo(heroTile, false));
        document.getElementById('zoom-map')?.addEventListener('click', () => canvasOn() && showMap());
        document.addEventListener('keydown', (e) => {
          if (!canvasOn() || e.metaKey || e.ctrlKey || e.altKey) return;
          const typing = e.target instanceof Element && e.target.closest('input, textarea, select, [contenteditable]');
          if ((e.key === 'm' || e.key === 'M') && !typing) {
            e.preventDefault();
            showMap();
          }
        });

        // In the map view, a click (not a drag) on a slide dives into it.
        let downAt = null;
        canvasViewport.addEventListener('pointerdown', (e) => { downAt = { x: e.clientX, y: e.clientY }; }, true);
        canvasViewport.addEventListener('pointerup', (e) => {
          if (!canvasOn() || !downAt || !canvasGrid.classList.contains('is-overview')) return;
          const moved = Math.hypot(e.clientX - downAt.x, e.clientY - downAt.y);
          downAt = null;
          if (moved > 5) return;
          const tile = document.elementsFromPoint(e.clientX, e.clientY).map((el) => el.closest('[data-tile]')).find(Boolean);
          if (tile) animateTo(tile, false);
        });

        // Keyboard focus landing in another panel travels there; inside the
        // current one it just nudges the element into view. Mouse clicks are
        // left alone (:focus-visible only).
        canvasGrid.addEventListener('focusin', (e) => {
          if (!canvasOn()) return;
          const tile = e.target.closest && e.target.closest('[data-tile]');
          const keyboard = e.target.matches && e.target.matches(':focus-visible');
          if (keyboard && tile && tile !== tileOrder[currentIndex]) {
            animateTo(tile, false);
            return;
          }
          if (anim) return;
          settleInstantly();
          const vpRect = canvasViewport.getBoundingClientRect();
          const elRect = e.target.getBoundingClientRect();
          const margin = 32;
          let dx = 0;
          let dy = 0;
          if (elRect.left < vpRect.left + margin) dx = vpRect.left + margin - elRect.left;
          else if (elRect.right > vpRect.right - margin) dx = vpRect.right - margin - elRect.right;
          if (elRect.top < vpRect.top + margin) dy = vpRect.top + margin - elRect.top;
          else if (elRect.bottom > vpRect.bottom - margin) dy = vpRect.bottom - margin - elRect.bottom;
          if (dx || dy) {
            const scale = panzoom.getScale();
            panzoom.pan(dx / scale, dy / scale, { relative: true, animate: !reduceMotion });
          }
        });

        // Keep the current panel framed when the window changes size.
        let resizeTimer = 0;
        window.addEventListener('resize', () => {
          if (!canvasOn()) return;
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            if (!canvasOn()) return;
            matchSlideAspect();
            fitSlides();
            layoutConnectors();
            animateTo(tileOrder[currentIndex], true);
          }, 150);
        });
      }

      // ── Hanging logo ──
      // The mark hangs from two strings, one tied to the tip of the L and one
      // to the top of the G, anchored above the top of the screen. Three damped
      // springs drive it: sideways sway, vertical bounce (the strings stretch)
      // and tilt, which rests a few degrees to the left. It drops in from off
      // screen, top-left, on load. After that, whatever moves the content (a
      // canvas glide, a drag, a zoom, or page scroll on phones) pushes on it:
      // speed reads like wind, changes in speed like inertia, so it trails
      // the movement and swings back when things settle.
      const logo = document.getElementById('site-logo');
      const strings = document.getElementById('logo-strings');
      if (logo && strings) {
        const [lineL, lineG] = strings.querySelectorAll('line');
        const deg = Math.PI / 180;
        const REST_TILT = -4; // degrees; negative leans left
        // Spring constants per axis: [stiffness, damping].
        const K = { x: [55, 5.5], y: [120, 8.5], t: [80, 6] };
        const st = { x: -140, y: -230, t: -24, vx: 0, vy: 0, vt: 0 };
        if (reduceMotion) Object.assign(st, { x: 0, y: 0, t: REST_TILT });
        let geo = null;
        const measure = () => {
          // Rest geometry in screen px: pivot midway between the two ties.
          const w = logo.offsetWidth;
          const left = parseFloat(getComputedStyle(logo).left);
          const top = parseFloat(getComputedStyle(logo).top);
          const tieL = w * 0.004, tieG = w * 0.75; // tip of the L, top of the G
          geo = { left, top, pivot: (tieL + tieG) / 2, half: (tieG - tieL) / 2, tieL, tieG };
          logo.style.transformOrigin = `${geo.pivot}px 0`;
        };
        measure();
        window.addEventListener('resize', measure);

        // Where the content is on screen, so its velocity can drive the logo.
        const contentPos = () => {
          if (canvasOn()) {
            // Read the live transform: glides write it directly and only
            // hand the final state to Panzoom when they land.
            const m = /scale\(([-\d.e]+)\)\s*translate\(([-\d.e]+)px,\s*([-\d.e]+)px\)/.exec(canvasGrid.style.transform);
            const s = m ? +m[1] : panzoom.getScale();
            const p = m ? { x: +m[2], y: +m[3] } : panzoom.getPan();
            const c = centerOf(s, p.x, p.y);
            return { x: -c.x * s, y: -c.y * s, s };
          }
          return { x: 0, y: -window.scrollY, s: 1 };
        };
        let lastMode = canvasOn();
        let prev = contentPos();
        let pv = { x: 0, y: 0, s: 0 };
        let last = performance.now();
        const tick = (now) => {
          requestAnimationFrame(tick);
          const dt = Math.min(0.033, (now - last) / 1000);
          last = now;
          if (!dt) return;
          const cur = contentPos();
          // Content velocity (px/s) and acceleration. The canvas switching on
          // or off, or a jump in scale, resets the reference instead of
          // reading as a shove.
          const mode = canvasOn();
          if (mode !== lastMode) {
            lastMode = mode;
            prev = cur;
            pv = { x: 0, y: 0, s: 0 };
          }
          const scaleJump = Math.abs(cur.s - prev.s) / prev.s > 0.25;
          const v = scaleJump ? pv : { x: (cur.x - prev.x) / dt, y: (cur.y - prev.y) / dt, s: (cur.s - prev.s) / dt };
          const a = { x: (v.x - pv.x) / dt, y: (v.y - pv.y) / dt };
          prev = cur;
          pv = v;
          if (reduceMotion) return;
          const clamp = (n, m) => Math.max(-m, Math.min(m, n));
          const vx = clamp(v.x, 4000), vy = clamp(v.y, 4000);
          const ax = clamp(a.x, 20000), ay = clamp(a.y, 20000);
          // Inertia (swings the way the content surges) + wind (leans with
          // the content's speed), so the logo trails each move and settles.
          const fx = 0.24 * ax + 0.045 * vx;
          const fy = 0.12 * ay - 90 * clamp(v.s, 3);
          const ft = 0.11 * ax + 0.17 * vx - 0.5 * st.vx;
          st.vx += (-K.x[0] * st.x - K.x[1] * st.vx + fx) * dt;
          st.vy += (-K.y[0] * st.y - K.y[1] * st.vy + fy) * dt;
          st.vt += (-K.t[0] * (st.t - REST_TILT) - K.t[1] * st.vt + ft) * dt;
          st.x = clamp(st.x + st.vx * dt, 400);
          st.y = clamp(st.y + st.vy * dt, 400);
          st.t = clamp(st.t + st.vt * dt, 35);
          render();
        };
        const render = () => {
          logo.style.transform = `translate(${st.x.toFixed(2)}px, ${st.y.toFixed(2)}px) rotate(${st.t.toFixed(2)}deg)`;
          // Strings run from the ties straight up to fixed anchors off screen.
          const px = geo.left + geo.pivot + st.x;
          const py = geo.top + st.y;
          const cos = Math.cos(st.t * deg), sin = Math.sin(st.t * deg);
          const ends = [
            [lineL, px - geo.half * cos, py - geo.half * sin, geo.left + geo.tieL],
            [lineG, px + geo.half * cos, py + geo.half * sin, geo.left + geo.tieG],
          ];
          ends.forEach(([ln, x, y, ax]) => {
            ln.setAttribute('x1', String(ax));
            ln.setAttribute('y1', '-40');
            ln.setAttribute('x2', x.toFixed(2));
            ln.setAttribute('y2', y.toFixed(2));
          });
        };
        render();
        requestAnimationFrame(tick);
      }

      // In-page links: on the canvas, zoom out and back in on the panel; on
      // the mobile page, just scroll to it.
      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href').slice(1);
          const target = id && document.getElementById(id);
          if (!target) return;
          e.preventDefault();
          if (canvasOn()) {
            animateTo(id === 'main' ? heroTile : target.closest('[data-tile]') || target, false);
          } else if (id === 'main') {
            window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
          } else {
            target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          }
        });
      });
    </script>
  </body>
</html>
