---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'L Dante Guarin — Product & Fractional Design for Startups',
  description = 'L Dante Guarin is a fractional design lead — design leadership, design systems and AI-assisted workflows for growing product teams. 20+ years in enterprise SaaS. $3.1M+ saved, 6x adoption shipped.',
} = Astro.props;

const siteUrl = 'https://ldanteguarin.com';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      name: 'L Dante Guarin',
      jobTitle: 'Fractional Design Lead',
      url: siteUrl,
      email: 'mailto:hello@ldante.com',
      sameAs: ['https://linkedin.com/in/ldanteguarin', 'https://ldante.com'],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Los Angeles',
        addressRegion: 'CA',
        addressCountry: 'US',
      },
      knowsAbout: [
        'Product Design',
        'Design Systems',
        'AI-Assisted Design Workflows',
        'Design Leadership',
        'Enterprise SaaS',
      ],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}/#service`,
      name: 'L Dante Guarin — Fractional Design Leadership',
      url: siteUrl,
      description,
      provider: { '@id': `${siteUrl}/#person` },
      areaServed: 'US',
      serviceType: ['Fractional Design Leadership', 'Design Systems', 'Interim Design Leadership'],
    },
  ],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta name="theme-color" content="#1c1c1c" />
    <link rel="canonical" href={siteUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cal+Sans&family=Golos+Text:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (localStorage.getItem('ldg-cases-unlocked')) document.documentElement.classList.add('cases-unlocked');
      } catch {}
    </script>
  </head>
  <body class="bg-charcoal text-neutral-400 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:bg-pink focus:text-charcoal focus:font-semibold focus:px-4 focus:py-2 focus:rounded-full"
    >
      Skip to content
    </a>
    <slot />
    <div id="zoom-controls">
      <button type="button" id="zoom-in" aria-label="Zoom in">+</button>
      <button type="button" id="zoom-out" aria-label="Zoom out">−</button>
      <button type="button" id="zoom-reset" aria-label="Back to the top panel">⌂</button>
    </div>
    <script>
      import Panzoom from '@panzoom/panzoom';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const canvasViewport = document.getElementById('canvas-viewport');
      const canvasGrid = document.getElementById('canvas-grid');
      const canvasMain = canvasGrid && canvasGrid.parentElement;
      // Same breakpoint as the canvas CSS. The canvas switches on and off
      // live when the window crosses it, not just at page load.
      const desktop = window.matchMedia('(min-width: 901px)');
      const canvasOn = () => !!panzoom;
      let panzoom = null;

      // Scroll-reveal for the mobile page (the canvas CSS shows everything
      // regardless); no-JS and reduced-motion always show everything.
      const els = document.querySelectorAll('[data-reveal]');
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.setAttribute('data-revealed', 'true');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.setAttribute('data-revealed', 'true'));
      }

      const tileOrder = canvasGrid ? Array.from(canvasGrid.querySelectorAll('[data-tile]')) : [];
      const heroTile = document.getElementById('hero');
      let currentIndex = 0;

      // ── Geometry ──
      // Panzoom's transform is `scale(s) translate(tx, ty)` about the grid's
      // centre, so a view is the canvas point at the middle of the viewport
      // plus a scale. Tile positions come from offsetLeft/Top, which are
      // grid-local (and ignore the transform) because the grid is
      // position:relative.
      const vpSize = () => ({ w: canvasViewport.clientWidth, h: canvasViewport.clientHeight });
      function stateFor(c, s) {
        const v = vpSize();
        const W = canvasGrid.offsetWidth;
        const H = canvasGrid.offsetHeight;
        return { s, tx: (v.w / 2 - W / 2) / s + W / 2 - c.x, ty: (v.h / 2 - H / 2) / s + H / 2 - c.y };
      }
      function centerOf(s, tx, ty) {
        const v = vpSize();
        const W = canvasGrid.offsetWidth;
        const H = canvasGrid.offsetHeight;
        return { x: (v.w / 2 - W / 2) / s + W / 2 - tx, y: (v.h / 2 - H / 2) / s + H / 2 - ty };
      }
      // Where a panel lands: at full size (only shrunk if it's wider than
      // the window), centred if it fits, otherwise with its top edge just
      // below the header so it reads from the start — scroll to see the rest.
      // Where a slide lands: centred and scaled so the whole slide fills the
      // window (a little breathing room at the edges).
      function frameFor(t) {
        const v = vpSize();
        const m = 20;
        const s = Math.min(1.35, Math.max(0.3, Math.min((v.w - 2 * m) / t.offsetWidth, (v.h - 2 * m) / t.offsetHeight)));
        return { s, c: { x: t.offsetLeft + t.offsetWidth / 2, y: t.offsetTop + t.offsetHeight / 2 } };
      }

      // Slides are a fixed size; if a slide's content runs taller than the
      // slide, shrink that content to fit instead of letting it spill.
      function fitSlides() {
        tileOrder.forEach((t) => {
          const inner = t.querySelector(':scope > .tile-inner');
          if (!inner || t.classList.contains('case-tile')) return;
          inner.style.zoom = '';
          const cs = getComputedStyle(t);
          const avail = t.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
          const need = inner.scrollHeight;
          if (need > avail) inner.style.zoom = String(Math.max(0.6, avail / need));
        });
      }
      function unfitSlides() {
        tileOrder.forEach((t) => {
          const inner = t.querySelector(':scope > .tile-inner');
          if (inner) inner.style.zoom = '';
        });
      }
      // Force the DOM transform to match Panzoom's logical state (Panzoom
      // writes inside requestAnimationFrame and no-ops on unchanged values).
      function settleInstantly() {
        const p = panzoom.getPan();
        const s = panzoom.getScale();
        canvasGrid.style.transition = 'none';
        canvasGrid.style.transform = `scale(${s}) translate(${p.x}px, ${p.y}px)`;
      }
      // Hand a finished view back to Panzoom so drag/zoom continue from it.
      function commit(st) {
        panzoom.zoom(st.s, { animate: false });
        panzoom.pan(st.tx, st.ty, { animate: false });
        settleInstantly();
      }

      // ── Zoom-out / zoom-in navigation ──
      let anim = null;
      // Damped wobble over the last stretch of the move: 0 at both ends, a
      // few decaying swings between, so every landing settles exactly.
      const wobble = (u) => {
        const t = (u - 0.62) / 0.38;
        return t <= 0 ? 0 : Math.sin(Math.PI * 3 * t) * (1 - t) * (1 - t);
      };
      const easeInOut = (u) => (u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2);

      function cancelAnim() {
        if (!anim) return;
        cancelAnimationFrame(anim.raf);
        const last = anim.last;
        anim = null;
        canvasMain.style.transform = '';
        if (last) commit(last);
      }

      function animateTo(tile, instant) {
        cancelAnim();
        const idx = tileOrder.indexOf(tile);
        if (idx !== -1) currentIndex = idx;
        const { s: s1, c: g1 } = frameFor(tile);
        const end = stateFor(g1, s1);
        if (instant || reduceMotion) {
          commit(end);
          return;
        }
        const s0 = panzoom.getScale();
        const p0 = panzoom.getPan();
        const c0 = centerOf(s0, p0.x, p0.y);
        if (Math.hypot(c0.x - g1.x, c0.y - g1.y) < 2 && Math.abs(s0 - s1) < 0.01) return;

        // A gentle glide rather than a hop: the view pulls back only slightly
        // (a little more for longer trips) and heads straight for the target.
        // As the new slide comes in it swings in at an angle and straightens
        // as it lands. The tilt goes on #main, whose centre is the viewport's
        // — rotating the grid would pivot about the whole canvas.
        const dist = Math.hypot(g1.x - c0.x, g1.y - c0.y);
        const dip = 0.12 + 0.1 * Math.min(1, dist / 5000);
        const lean = (g1.x >= c0.x ? 1 : -1) * (2.2 + Math.random() * 0.6);
        const duration = 1150;
        const t0 = performance.now();
        anim = { raf: 0, last: null };
        const frame = (now) => {
          const u = Math.min(1, (now - t0) / duration);
          const e = easeInOut(u);
          const b = Math.sin(Math.PI * u);
          const w = wobble(u);
          const s = Math.exp(Math.log(s0) + (Math.log(s1) - Math.log(s0)) * e - dip * b) * (1 + 0.01 * w);
          const c = { x: c0.x + (g1.x - c0.x) * e, y: c0.y + (g1.y - c0.y) * e };
          const st = stateFor(c, s);
          // Arrival tilt: 0 until the second half, swings in, settles to 0.
          const a = Math.min(1, Math.max(0, (u - 0.4) / 0.6));
          const tilt = lean * Math.sin(Math.PI * a) * (1 - 0.35 * a) - lean * 0.25 * w;
          canvasGrid.style.transition = 'none';
          canvasGrid.style.transform = `scale(${st.s}) translate(${st.tx}px, ${st.ty}px)`;
          canvasMain.style.transform = u < 1 ? `rotate(${tilt}deg)` : '';
          anim.last = st;
          if (u < 1) {
            anim.raf = requestAnimationFrame(frame);
          } else {
            anim = null;
            commit(end);
          }
        };
        anim.raf = requestAnimationFrame(frame);
      }

      function zoomAtCenter(factor) {
        cancelAnim();
        const r = canvasViewport.getBoundingClientRect();
        panzoom.zoomToPoint(
          panzoom.getScale() * factor,
          { clientX: r.left + r.width / 2, clientY: r.top + r.height / 2 },
          { animate: !reduceMotion }
        );
      }

      // ── Connectors + edge signposts ──
      // Dotted curves join the panels in reading order. They're drawn once,
      // in canvas space, inside the grid — so they pan and zoom rigidly with
      // the panels. Separately, when a neighbouring panel is off-screen, a
      // signpost pill sits on the screen edge in the direction of that panel.
      const SVG_NS = 'http://www.w3.org/2000/svg';
      // Two chains: the main site in reading order, and the case-study branch
      // hanging off the Case studies panel.
      const chain = (list) => list.slice(1).map((t, i) => [list[i], t]);
      const mainChain = tileOrder.filter((t) => !t.dataset.branch);
      const caseHub = document.getElementById('case-studies');
      const caseChain = [caseHub, ...tileOrder.filter((t) => t.dataset.branch === 'cases')].filter(Boolean);
      const pairs = [...chain(mainChain), ...(caseChain.length > 1 ? chain(caseChain) : [])];
      let overlay = null;
      let lineLayer = null;
      let links = [];
      let posts = new Map();
      let hotTile = null;
      let overlayRaf = 0;

      function buildOverlay() {
        lineLayer = document.createElementNS(SVG_NS, 'svg');
        lineLayer.id = 'canvas-lines';
        lineLayer.setAttribute('aria-hidden', 'true');
        links = pairs.map(([a, b]) => {
          const path = document.createElementNS(SVG_NS, 'path');
          path.setAttribute('class', 'connector');
          const ends = [0, 1].map(() => {
            const dot = document.createElementNS(SVG_NS, 'circle');
            dot.setAttribute('class', 'connector-end');
            dot.setAttribute('r', '5');
            return dot;
          });
          lineLayer.append(path, ...ends);
          return { a, b, path, ends };
        });
        canvasGrid.prepend(lineLayer);
        layoutConnectors();

        overlay = document.createElement('div');
        overlay.id = 'canvas-overlay';
        const dock = document.createElement('nav');
        dock.id = 'signpost-dock';
        dock.setAttribute('aria-label', 'Nearby sections');
        overlay.appendChild(dock);
        posts = new Map();
        tileOrder.forEach((tile) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'signpost';
          btn.hidden = true;
          btn.setAttribute('aria-label', `Go to ${tile.dataset.label}`);
          btn.innerHTML =
            '<span class="signpost-icon" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>' +
            '<span class="signpost-text"><span class="signpost-kicker"></span><span class="signpost-label"></span></span>';
          btn.querySelector('.signpost-label').textContent = tile.dataset.label;
          btn.addEventListener('click', () => animateTo(tile, false));
          btn.addEventListener('pointerenter', () => setHot(tile));
          btn.addEventListener('pointerleave', () => setHot(null));
          btn.addEventListener('focus', () => setHot(tile));
          btn.addEventListener('blur', () => setHot(null));
          dock.appendChild(btn);
          posts.set(tile, { btn, x: 0, y: 0, placed: false });
        });
        canvasViewport.appendChild(overlay);
        overlayRaf = requestAnimationFrame(drawOverlay);
      }
      function destroyOverlay() {
        cancelAnimationFrame(overlayRaf);
        overlay?.remove();
        lineLayer?.remove();
        overlay = null;
        lineLayer = null;
        hotTile = null;
      }
      // Hovering a signpost lights up the line from the panel you're on to
      // the one it points at.
      function setHot(tile) {
        hotTile = tile;
        const from = tile && posts.get(tile)?.near;
        links.forEach((L) =>
          L.path.classList.toggle('is-hot', !!from && ((L.a === tile && L.b === from) || (L.b === tile && L.a === from)))
        );
      }

      // Where a ray from a rect's centre toward point p crosses its edge,
      // plus the outward normal of that side.
      function exitPoint(r, p) {
        const cx = r.x + r.w / 2;
        const cy = r.y + r.h / 2;
        const dx = p.x - cx;
        const dy = p.y - cy;
        const tx = dx === 0 ? Infinity : (r.w / 2) / Math.abs(dx);
        const ty = dy === 0 ? Infinity : (r.h / 2) / Math.abs(dy);
        const t = Math.min(tx, ty);
        return tx < ty
          ? { x: cx + dx * t, y: cy + dy * t, nx: Math.sign(dx), ny: 0 }
          : { x: cx + dx * t, y: cy + dy * t, nx: 0, ny: Math.sign(dy) };
      }
      const canvasRect = (t) => ({ x: t.offsetLeft, y: t.offsetTop, w: t.offsetWidth, h: t.offsetHeight });

      // Static curves between facing panel edges, in canvas coordinates.
      function layoutConnectors() {
        if (!lineLayer) return;
        lineLayer.setAttribute('width', canvasGrid.offsetWidth);
        lineLayer.setAttribute('height', canvasGrid.offsetHeight);
        links.forEach((L) => {
          const ra = canvasRect(L.a);
          const rb = canvasRect(L.b);
          const pa = exitPoint(ra, { x: rb.x + rb.w / 2, y: rb.y + rb.h / 2 });
          const pb = exitPoint(rb, { x: ra.x + ra.w / 2, y: ra.y + ra.h / 2 });
          const k = Math.min(Math.hypot(pb.x - pa.x, pb.y - pa.y) * 0.45, 280);
          L.path.setAttribute(
            'd',
            `M${pa.x} ${pa.y}C${pa.x + pa.nx * k} ${pa.y + pa.ny * k} ${pb.x + pb.nx * k} ${pb.y + pb.ny * k} ${pb.x} ${pb.y}`
          );
          [pa, pb].forEach((p, i) => {
            L.ends[i].setAttribute('cx', p.x);
            L.ends[i].setAttribute('cy', p.y);
          });
        });
      }

      function clipRect(r, W, H) {
        const x0 = Math.max(r.x, 0);
        const y0 = Math.max(r.y, 0);
        const x1 = Math.min(r.x + r.w, W);
        const y1 = Math.min(r.y + r.h, H);
        return x1 - x0 > 80 && y1 - y0 > 80 ? { x: x0, y: y0, w: x1 - x0, h: y1 - y0 } : null;
      }

      // Signposts: for each neighbouring pair with one panel on screen and
      // the other off it, a pill for the hidden panel appears in a fixed
      // stack in the bottom-right corner (Case study / Next / Back, top to
      // bottom). Its arrow still points toward the panel, snapped to eight
      // directions.
      const KICKER_ORDER = { 'Case study': 1, Next: 2, Back: 3 };
      function drawOverlay() {
        overlayRaf = requestAnimationFrame(drawOverlay);
        if (!overlay) return;
        const vp = canvasViewport.getBoundingClientRect();
        const W = vp.width;
        const H = vp.height;
        const rects = new Map(
          tileOrder.map((t) => {
            const b = t.getBoundingClientRect();
            return [t, { x: b.left - vp.left, y: b.top - vp.top, w: b.width, h: b.height }];
          })
        );
        const visible = new Map(tileOrder.map((t) => [t, clipRect(rects.get(t), W, H)]));
        const wanted = new Map();

        pairs.forEach(([a, b]) => {
          const va = visible.get(a);
          const vb = visible.get(b);
          if (!va === !vb) return;
          const [near, far] = va ? [a, b] : [b, a];
          if (wanted.has(far)) return;
          const nr = visible.get(near);
          const fr = rects.get(far);
          const dx = fr.x + fr.w / 2 - (nr.x + nr.w / 2);
          const dy = fr.y + fr.h / 2 - (nr.y + nr.h / 2);
          const angle = Math.round(Math.atan2(dy, dx) / (Math.PI / 4)) * 45;
          const forward = tileOrder.indexOf(far) > tileOrder.indexOf(near);
          const kicker = !forward ? 'Back' : far.dataset.branch ? 'Case study' : 'Next';
          wanted.set(far, { angle, kicker, near });
        });

        const moving = !!anim;
        posts.forEach((p, tile) => {
          const sp = wanted.get(tile);
          if (!sp || moving) {
            if (!p.btn.hidden) p.btn.hidden = true;
            p.key = null;
            if (hotTile === tile && !sp) setHot(null);
            return;
          }
          p.near = sp.near;
          const key = `${sp.kicker}|${sp.angle}`;
          if (key === p.key) return; // nothing changed: leave the DOM alone
          const appearing = p.btn.hidden;
          p.key = key;
          p.btn.querySelector('.signpost-kicker').textContent = sp.kicker;
          p.btn.style.order = String(KICKER_ORDER[sp.kicker]);
          p.btn.style.setProperty('--arrow-angle', `${sp.angle}deg`);
          p.btn.hidden = false;
          if (appearing && !reduceMotion) {
            p.btn.getAnimations().forEach((an) => an.id === 'grow' && an.cancel());
            p.btn.animate(
              [
                { scale: 0.35, opacity: 0 },
                { scale: 1, opacity: 1 },
              ],
              { id: 'grow', duration: 480, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
            );
          }
        });
      }

      // ── Switching the canvas on and off ──
      function enableCanvas() {
        if (canvasOn() || !canvasGrid) return;
        panzoom = Panzoom(canvasGrid, {
          canvas: true,
          cursor: 'grab',
          minScale: 0.05,
          maxScale: 3,
          animate: !reduceMotion,
          duration: 300,
          easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
        });
        buildOverlay();
        document.fonts.ready.then(() => requestAnimationFrame(() => requestAnimationFrame(() => {
          if (canvasOn()) {
            fitSlides();
            layoutConnectors();
            animateTo(tileOrder[currentIndex] || heroTile, true);
          }
        })));
      }
      function disableCanvas() {
        if (!canvasOn()) return;
        cancelAnim();
        destroyOverlay();
        panzoom.destroy();
        panzoom = null;
        canvasGrid.style.transform = '';
        canvasGrid.style.transition = '';
        canvasMain.style.transform = '';
        canvasMain.style.cursor = '';
        unfitSlides();
      }
      if (canvasViewport && canvasGrid) {
        if (desktop.matches) enableCanvas();
        desktop.addEventListener('change', (e) => (e.matches ? enableCanvas() : disableCanvas()));

        // Scroll / two-finger swipe pans the canvas freely; Ctrl/Cmd+wheel
        // (also how browsers report a trackpad pinch) zooms at the pointer.
        canvasViewport.addEventListener(
          'wheel',
          (e) => {
            if (!canvasOn()) return;
            // Over a case write-up that can still scroll this way, let it
            // scroll instead of panning the canvas.
            const scroller = !e.ctrlKey && e.target.closest && e.target.closest('.case-scroll');
            if (scroller && Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
              const canScroll = e.deltaY > 0
                ? scroller.scrollTop + scroller.clientHeight < scroller.scrollHeight - 1
                : scroller.scrollTop > 0;
              if (canScroll) return;
            }
            e.preventDefault();
            cancelAnim();
            if (e.ctrlKey) {
              panzoom.zoomWithWheel(e, { animate: false });
              return;
            }
            const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? vpSize().h : 1;
            const scale = panzoom.getScale();
            panzoom.pan((-e.deltaX * unit) / scale, (-e.deltaY * unit) / scale, { relative: true, animate: false });
          },
          { passive: false }
        );

        // Grabbing the canvas mid-flight takes over from the animation.
        canvasViewport.addEventListener('pointerdown', () => canvasOn() && cancelAnim(), true);

        // Keyboard: arrow keys pan, +/- zoom, 0 returns to the hero — only
        // when the viewport itself has focus, so this never fights a nested
        // control's own arrow-key behavior (like the "find your fit" tablist).
        canvasViewport.addEventListener('keydown', (e) => {
          if (!canvasOn() || document.activeElement !== canvasViewport) return;
          const step = 80;
          const scale = panzoom.getScale();
          const pan = (x, y) => {
            cancelAnim();
            panzoom.pan(x / scale, y / scale, { relative: true, animate: !reduceMotion });
          };
          const actions = {
            ArrowUp: () => pan(0, step),
            ArrowDown: () => pan(0, -step),
            ArrowLeft: () => pan(step, 0),
            ArrowRight: () => pan(-step, 0),
            '+': () => zoomAtCenter(1.3),
            '=': () => zoomAtCenter(1.3),
            '-': () => zoomAtCenter(1 / 1.3),
            _: () => zoomAtCenter(1 / 1.3),
            '0': () => animateTo(heroTile, false),
          };
          if (actions[e.key]) {
            e.preventDefault();
            actions[e.key]();
          }
        });

        document.getElementById('zoom-in')?.addEventListener('click', () => canvasOn() && zoomAtCenter(1.3));
        document.getElementById('zoom-out')?.addEventListener('click', () => canvasOn() && zoomAtCenter(1 / 1.3));
        document.getElementById('zoom-reset')?.addEventListener('click', () => canvasOn() && animateTo(heroTile, false));

        // Keyboard focus landing in another panel travels there; inside the
        // current one it just nudges the element into view. Mouse clicks are
        // left alone (:focus-visible only).
        canvasGrid.addEventListener('focusin', (e) => {
          if (!canvasOn()) return;
          const tile = e.target.closest && e.target.closest('[data-tile]');
          const keyboard = e.target.matches && e.target.matches(':focus-visible');
          if (keyboard && tile && tile !== tileOrder[currentIndex]) {
            animateTo(tile, false);
            return;
          }
          if (anim) return;
          settleInstantly();
          const vpRect = canvasViewport.getBoundingClientRect();
          const elRect = e.target.getBoundingClientRect();
          const margin = 32;
          let dx = 0;
          let dy = 0;
          if (elRect.left < vpRect.left + margin) dx = vpRect.left + margin - elRect.left;
          else if (elRect.right > vpRect.right - margin) dx = vpRect.right - margin - elRect.right;
          if (elRect.top < vpRect.top + margin) dy = vpRect.top + margin - elRect.top;
          else if (elRect.bottom > vpRect.bottom - margin) dy = vpRect.bottom - margin - elRect.bottom;
          if (dx || dy) {
            const scale = panzoom.getScale();
            panzoom.pan(dx / scale, dy / scale, { relative: true, animate: !reduceMotion });
          }
        });

        // Keep the current panel framed when the window changes size.
        let resizeTimer = 0;
        window.addEventListener('resize', () => {
          if (!canvasOn()) return;
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(() => {
            if (!canvasOn()) return;
            fitSlides();
            layoutConnectors();
            animateTo(tileOrder[currentIndex], true);
          }, 150);
        });
      }

      // In-page links: on the canvas, zoom out and back in on the panel; on
      // the mobile page, just scroll to it.
      document.querySelectorAll('a[href^="#"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const id = a.getAttribute('href').slice(1);
          const target = id && document.getElementById(id);
          if (!target) return;
          e.preventDefault();
          if (canvasOn()) {
            animateTo(id === 'main' ? heroTile : target.closest('[data-tile]') || target, false);
          } else if (id === 'main') {
            window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
          } else {
            target.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
          }
        });
      });
    </script>
  </body>
</html>
