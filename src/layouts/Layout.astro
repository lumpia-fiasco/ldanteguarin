---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'L Dante Guarin — Fractional Design Leadership',
  description = 'Senior design leadership for Series A–C startups. Embedded expertise without the full-time overhead.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=DM+Serif+Display:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body class="bg-neutral-950 text-neutral-100 antialiased">
    <slot />
  </body>
</html>
